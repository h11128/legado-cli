{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legado-cli.local/repair_contracts/optimize_plan.schema.json",
  "title": "OptimizePlan",
  "description": "Before/after optimize plan (architecture §3.5 / §8.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "before", "after", "changes", "risk"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "before": { "type": "object", "additionalProperties": true },
    "after": { "type": "object", "additionalProperties": true },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "set", "delete", "migrate_host", "merge_into",
              "delete_source", "disable_source"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "value": true,
          "from_url": { "type": "string", "minLength": 1 },
          "to_url": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "risk": { "type": "string", "enum": ["low", "medium"] },
    "before_verify": { "type": "object", "additionalProperties": true },
    "after_verify": { "type": "object", "additionalProperties": true }
  }
}
