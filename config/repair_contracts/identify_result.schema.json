{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legado-cli.local/repair_contracts/identify_result.schema.json",
  "title": "IdentifyResult",
  "description": "Site-family identify outcome (architecture §3.4 / §8.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "url", "family", "fingerprint", "score"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "url": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals", "structural_hash", "confidence"],
      "properties": {
        "signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "structural_hash": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence_urls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "score": { "type": "number" },
    "runner_up": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "score"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "score": { "type": "number" }
      }
    }
  }
}
