# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local dumps / device artifacts (do not commit)
temp/
backups/
*.log

# IDE noise (keep rules/skills that are intentional)
.cursor/hooks.json
.cursor/skills/
.cursor/agents/
.cursor/*.bak
.cursor/rules/*.bak

# OS
Thumbs.db
Desktop.ini
.DS_Store
# Rust
/crates/target/
/target/
# Commit workspace lock for reproducible CLI builds; ignore accidental nested locks.
**/Cargo.lock
!/crates/Cargo.lock
