# Example only — do NOT replace your whole `.cursor/hooks.json` with this file.
# `.cursor/hooks.json` is gitignored / machine-local. Merge entries into existing arrays.
#
# Tracked scripts:
#   .cursor/hooks/check-deep-active-stop.py
#   .cursor/hooks/mcp-save-source-closeout.py
#
# Merge into `hooks.stop`:
# {
#   "command": "python .cursor/hooks/check-deep-active-stop.py",
#   "timeout": 10,
#   "loop_limit": 2
# }
#
# Merge into `hooks.afterMCPExecution`:
# {
#   "command": "python .cursor/hooks/mcp-save-source-closeout.py",
#   "timeout": 45
# }

{
  "stop": [
    {
      "command": "audit-hooks hook"
    },
    {
      "command": "python .cursor/hooks/check-deep-active-stop.py",
      "timeout": 10,
      "loop_limit": 2,
      "_note": "Unsealed deep_active → followup close-out"
    }
  ],
  "afterMCPExecution": [
    {
      "command": "audit-hooks hook"
    },
    {
      "command": "python .cursor/hooks/mcp-save-source-closeout.py",
      "timeout": 45,
      "_note": "IDE save_source → claim deep_active"
    }
  ]
}
